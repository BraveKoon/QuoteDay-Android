<?xml version="1.0" encoding="utf-8"?>
<!--
    iOS 아이콘의 라벤더 바탕. 원본 PNG 에서 네 귀퉁이 색을 뽑아 대각선 그러데이션으로
    다시 그렸다. 사진을 그대로 깔지 않는 이유는 적응형 아이콘이 배경을 확대해서
    자르기 때문이다 — 그러면 귀퉁이 색이 화면 밖으로 밀려나 다른 색이 된다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FFE8E5FA" />
                <item android:offset="0.5" android:color="#FFD2D1F4" />
                <item android:offset="1" android:color="#FFE5D5EC" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
